{
  "about": "Cases shared by the gateway's widget package (gateway/internal/widget/fixtures_test.go) and the app's sanitize.ts (sanitize.test.ts): an input card, substrings its cleaned HTML must contain and substrings it must not. Each side serialises its own tree, so the substrings avoid void elements' closing syntax and anything else the two serialisers spell differently. Add a case here when either whitelist changes.",
  "cases": [
    { "name": "plain markup stays", "html": "<div><span class=\"a\">hi</span></div>", "contains": ["<div><span class=\"a\">hi</span></div>"] },
    { "name": "placeholders stay", "html": "<p>{{status}} / {{ a.b }}</p>", "contains": ["<p>{{status}} / {{ a.b }}</p>"] },
    { "name": "style attribute stays", "html": "<div style=\"color:red\">x</div>", "contains": ["<div style=\"color:red\">x</div>"] },
    { "name": "button stays without handlers", "html": "<button onclick=\"x()\" class=\"b\">go</button>", "contains": ["<button class=\"b\">go</button>"], "absent": ["onclick"] },
    { "name": "event handlers go", "html": "<div onclick=\"x()\" id=\"a\" onmouseover=\"y()\">t</div>", "contains": ["<div id=\"a\">t</div>"], "absent": ["onclick", "onmouseover"] },
    { "name": "elements outside the whitelist go with their subtree", "html": "<p>a</p><iframe src=\"https://x.test\">inner</iframe><form action=\"/p\"><input name=\"q\"></form><object data=\"x\">obj</object><p>b</p>", "contains": ["<p>a</p>", "<p>b</p>"], "absent": ["iframe", "inner", "form", "input", "object", "obj"] },
    { "name": "unknown and legacy tags go", "html": "<custom-el>x</custom-el><marquee>m</marquee><p>ok</p>", "contains": ["<p>ok</p>"], "absent": ["custom-el", "marquee", "x</", ">m<"] },
    { "name": "head-only tags go", "html": "<base href=\"https://x.test/\"><link rel=\"stylesheet\" href=\"https://x.test/a.css\"><meta http-equiv=\"refresh\" content=\"0\"><p>ok</p>", "contains": ["<p>ok</p>"], "absent": ["base", "link", "meta", "x.test"] },
    { "name": "media and embeds go", "html": "<video src=\"https://x.test/v\">v</video><audio src=\"https://x.test/a\"></audio><embed src=\"https://x.test/e\"><p>ok</p>", "contains": ["<p>ok</p>"], "absent": ["video", "audio", "embed", "x.test"] },
    { "name": "form controls go", "html": "<select><option>o</option></select><textarea>t</textarea><p>ok</p>", "contains": ["<p>ok</p>"], "absent": ["select", "option", "textarea"] },
    { "name": "html head body wrappers are unwrapped", "html": "<html><head></head><body><p>x</p></body></html>", "contains": ["<p>x</p>"], "absent": ["<html", "<head", "<body"] },
    { "name": "comments go", "html": "<p>a<!-- hidden -->b</p>", "contains": ["<p>ab</p>"], "absent": ["hidden", "<!--"] },
    { "name": "other attributes the whitelist drops", "html": "<div srcset=\"a 1x\" formaction=\"/x\" action=\"/y\" contenteditable=\"true\" draggable=\"true\" tabindex=\"0\" autofocus accesskey=\"k\" id=\"keep\">t</div>", "contains": ["<div id=\"keep\">t</div>"], "absent": ["srcset", "formaction", "action", "contenteditable", "draggable", "tabindex", "autofocus", "accesskey"] },
    { "name": "link target stays", "html": "<a href=\"https://e.test\" onmouseover=\"e()\" target=\"_blank\">x</a>", "contains": ["<a href=\"https://e.test\" target=\"_blank\">x</a>"], "absent": ["onmouseover"] },

    { "name": "inline script stays", "html": "<script>x()</script><p>k</p>", "contains": ["<script>x()</script>", "<p>k</p>"] },
    { "name": "script attributes are dropped", "html": "<script id=\"s\" onload=\"y()\">x()</script>", "contains": ["<script>x()</script>"], "absent": ["onload", "id="] },
    { "name": "two scripts stay", "html": "<script>1</script><script>2</script>", "contains": ["<script>1</script><script>2</script>"] },
    { "name": "script with a JavaScript type stays", "html": "<script type=\"text/javascript\">a()</script><script type=\"application/javascript\">b()</script>", "contains": ["a()", "b()"] },
    { "name": "external script goes", "html": "<script src=\"https://e.test/a.js\"></script><p>k</p>", "contains": ["<p>k</p>"], "absent": ["script", "e.test"] },
    { "name": "script with src and text goes", "html": "<script src=\"a.js\">inline()</script><p>k</p>", "contains": ["<p>k</p>"], "absent": ["script", "inline"] },
    { "name": "module script goes", "html": "<script type=\"module\">import x from 'y'</script><p>k</p>", "contains": ["<p>k</p>"], "absent": ["script", "import"] },
    { "name": "non-JavaScript script types go", "html": "<script type=\"text/plain\">p()</script><script type=\"application/json\">{}</script><script type=\"text/html\">h()</script><p>k</p>", "contains": ["<p>k</p>"], "absent": ["script", "p()", "h()"] },
    { "name": "script text with a comment opener goes", "html": "<script>var a = \"<!--\";</script><p>z</p>", "contains": ["<p>z</p>"], "absent": ["<!--", "var a", "script"] },
    { "name": "script text with a script tag goes", "html": "<script>var a = \"<script>\";</script><p>z</p>", "contains": ["<p>z</p>"], "absent": ["var a", "script"] },
    { "name": "script in svg goes", "html": "<svg><script>alert(1)</script><circle r=\"1\"></circle></svg>", "contains": ["<svg>", "<circle r=\"1\">"], "absent": ["alert", "script"] },

    { "name": "https link stays", "html": "<a href=\"https://e.test/x\">l</a>", "contains": ["<a href=\"https://e.test/x\">l</a>"] },
    { "name": "fragment link stays", "html": "<a href=\"#sec\">l</a>", "contains": ["<a href=\"#sec\">l</a>"] },
    { "name": "placeholder link stays", "html": "<a href=\"{{url}}\">l</a><a href=\"{{ a.b }}\">m</a>", "contains": ["<a href=\"{{url}}\">l</a>", "<a href=\"{{ a.b }}\">m</a>"] },
    { "name": "javascript link goes", "html": "<a href=\"javascript:alert(1)\">l</a>", "contains": ["<a>l</a>"], "absent": ["javascript", "href"] },
    { "name": "other link schemes go", "html": "<a href=\"http://e.test\">a</a><a href=\"data:text/html,x\">b</a><a href=\"//e.test\">c</a><a href=\"mailto:a@e.test\">d</a><a href=\"HTTPS://e.test\">e</a>", "contains": ["<a>a</a>", "<a>b</a>", "<a>c</a>", "<a>d</a>", "<a>e</a>"], "absent": ["href", "e.test"] },
    { "name": "href on other elements goes", "html": "<div href=\"https://e.test\">d</div><span href=\"#a\">s</span>", "contains": ["<div>d</div>", "<span>s</span>"], "absent": ["href"] },

    { "name": "data image stays", "html": "<img src=\"data:image/png;base64,AAAA\" alt=\"x\">", "contains": ["<img src=\"data:image/png;base64,AAAA\" alt=\"x\""] },
    { "name": "remote image goes", "html": "<img src=\"https://e.test/a.png\" alt=\"x\">", "contains": ["<img alt=\"x\""], "absent": ["e.test", "src"] },
    { "name": "svg data image goes", "html": "<img src=\"data:image/svg+xml;base64,AAAA\">", "absent": ["svg+xml", "src"] },
    { "name": "src on other elements goes", "html": "<div src=\"data:image/png;base64,AAAA\">d</div>", "contains": ["<div>d</div>"], "absent": ["src"] },

    { "name": "style attribute with a remote url goes", "html": "<div style=\"background:url(https://e.test/a.png)\">d</div>", "contains": ["<div>d</div>"], "absent": ["e.test", "style"] },
    { "name": "style attribute with a data url stays", "html": "<div style=\"background:url(data:image/png;base64,AAAA)\">d</div>", "contains": ["url(data:image/png;base64,AAAA)"] },
    { "name": "style attribute with quoted urls", "html": "<div style=\"background:url( 'https://e.test/a.png' )\">d</div><p style=\"background:url(&quot;http://e.test/b&quot;)\">p</p>", "contains": ["<div>d</div>", "<p>p</p>"], "absent": ["e.test", "style"] },
    { "name": "style attribute with import expression or escape goes", "html": "<a style=\"@import 'x'\">a</a><b style=\"width:expression(alert(1))\">b</b><i style=\"background:\\75rl(x)\">i</i>", "contains": ["<a>a</a>", "<b>b</b>", "<i>i</i>"], "absent": ["style", "import", "expression", "75rl"] },
    { "name": "style attribute with a resource function goes", "html": "<div style=\"background-image:image-set('https://e.test/a.png' 1x)\">a</div><div style=\"content:src(x)\">b</div>", "contains": ["<div>a</div>", "<div>b</div>"], "absent": ["style", "e.test"] },
    { "name": "style element stays", "html": "<style>p{color:red}</style><p>x</p>", "contains": ["<style>p{color:red}</style>", "<p>x</p>"] },
    { "name": "style element with a data url stays", "html": "<style>p{background:url(data:image/png;base64,AAAA)}</style>", "contains": ["url(data:image/png;base64,AAAA)"] },
    { "name": "style element with import goes", "html": "<style>@import url(https://e.test/a.css);p{color:red}</style><p>x</p>", "contains": ["<p>x</p>"], "absent": ["@import", "e.test", "style"] },
    { "name": "style element with a remote url goes", "html": "<style>p{background:url(https://e.test/a.png)}</style><p>x</p>", "contains": ["<p>x</p>"], "absent": ["e.test", "style"] },
    { "name": "style element with escapes or expression goes", "html": "<style>p{color:\\72ed}</style><style>p{width:expression(1)}</style><p>x</p>", "contains": ["<p>x</p>"], "absent": ["72ed", "expression", "style"] },

    { "name": "svg paints with a local reference stay", "html": "<svg><defs><lineargradient id=\"g\"></lineargradient></defs><rect fill=\"url(#g)\" width=\"1\"></rect></svg>", "contains": ["fill=\"url(#g)\"", "id=\"g\""] },
    { "name": "svg paints with a remote url go", "html": "<svg><rect fill=\"url(https://e.test/x)\" stroke=\"url(  'http://e.test/y' )\" width=\"1\"></rect></svg>", "contains": ["<rect width=\"1\">"], "absent": ["e.test", "fill", "stroke"] },
    { "name": "svg values with a backslash go", "html": "<svg><rect fill=\"\\75rl(x)\" width=\"1\"></rect></svg>", "contains": ["<rect width=\"1\">"], "absent": ["75rl", "fill"] },
    { "name": "svg use stays when local", "html": "<svg><symbol id=\"a\"></symbol><use href=\"#a\"></use></svg>", "contains": ["<use href=\"#a\">"] },
    { "name": "svg use with an external reference goes", "html": "<svg><use href=\"https://e.test/s.svg#a\"></use></svg>", "contains": ["<use>"], "absent": ["e.test", "href"] },
    { "name": "svg elements outside the whitelist go", "html": "<svg><foreignObject><p>fo</p></foreignObject><image href=\"https://e.test/a.png\"></image><circle r=\"2\"></circle></svg>", "contains": ["<circle r=\"2\">"], "absent": ["foreignobject", "fo<", "image", "e.test"] },
    { "name": "svg event handlers go", "html": "<svg onload=\"x()\"><circle onclick=\"y()\" r=\"2\"></circle></svg>", "contains": ["<svg>", "<circle r=\"2\">"], "absent": ["onload", "onclick"] }
  ]
}
