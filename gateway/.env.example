# Copy to .env next to docker-compose.yml.
HONK_IMAGE_TAG=latest
HONK_APNS_KEY_ID=ABC123DEFG
HONK_APNS_TEAM_ID=ABCDE12345
HONK_APNS_TOPIC=dev.evumi.honk
# true for apps built with a development profile (Xcode debug builds).
HONK_APNS_SANDBOX=false
HONK_MESSAGE_TTL=168h
# Push relay (see docs/SELF-HOSTING.md). A gateway without APNs/FCM credentials
# uses the official relay; HONK_RELAY_URL=off turns that off.
# HONK_RELAY_URL=https://honk.bunship.site/
# HONK_RELAY_SERVE=false
# HONK_PUSH_CONTENT=full   # full | none; default full for direct pushes, none through a relay
# HONK_RELAY_RATE=10
# HONK_RELAY_BURST=100
# HONK_RELAY_TOKEN_PER_MINUTE=60
# Optional: devices must send this key to register (the app's Gateway page has a field for it).
# HONK_REGISTER_KEY=
# HONK_LOG_FORMAT=json
# HONK_LOG_LEVEL=info
